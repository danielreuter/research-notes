+/-- F2's cost of the masked int8 route per useful MAC (theory §6.3, bc-d9842080's pinned `c_L`, W1's leaf 2.0): the best
+depth `L`, from 1 to `log₂(k/16)` (NVFP4's UE4M3 block of 16), of `2·(7/8)^L + 4.25·(1/m + 1/n)·((7/4)^L − 1)/0.75`;
+`1`, no saving, when no depth fits. -/
+def cL (m k n : ℕ) : ℚ :=
+  ((List.range (Nat.log2 (k / 16))).map fun L : ℕ =>
+    2 * (7 / 8 : ℚ) ^ (L + 1) + 17 / 4 * (1 / (m : ℚ) + 1 / n) * ((7 / 4 : ℚ) ^ (L + 1) - 1) / (3 / 4)).foldl min 1
+
+/-- F2's flatness: the share of the rows `I`'s scale bytes at their most common byte (the tile's modal byte). -/
+noncomputable def modalShare {p : ℕ} (A : Op4 p) (I : Finset (Fin p)) : ℚ :=
+  let cnt := fun v : Fin 256 => ∑ i ∈ I, ((A i).map fun r => r.2.count v).getD 0
+  let tot := ∑ i ∈ I, ((A i).map fun r => r.2.length).getD 0
+  if tot = 0 then 0 else (((univ : Finset (Fin 256)).sup cnt : ℕ) : ℚ) / tot
+
 end Pouw.PearlC.Fp4Dev
 
