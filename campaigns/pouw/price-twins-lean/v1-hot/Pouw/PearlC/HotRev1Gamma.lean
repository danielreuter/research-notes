/-- **v1-hot under rev1 at the cap 1/400, 8192³**, FP32 at 8.00, the honest cast at 8, under any H_{i,g} sizing rule
`h`: γ = `gammaHotRev1 d h (8 - 8) (1 / 400) sh8192` (`gammaHotRev1_…` give its values). -/
theorem pearlCGammaSm120v1HotCast8_8192
    (P : Protocol Q R S) (D : Layout → Prop) (d : PearlCDevice) (h : HotSizing) (hG : d.G = 4)
    (hp : d.prices = Prices.sm120)
    (hacc : HotRev1UnitAccounting P D d h (8 - 8) (1 / 400) sh8192)
    (hTT : TTOut CM P D (1 / 400) εPearlC) :
    Gγ CM P D (gammaHotRev1 d h (8 - 8) (1 / 400) sh8192 : ℝ) εPearlC :=
  pearlCGammaHotRev1At CM P D d h _ _ _ (by norm_num)
    (by rw [creditDevRev1Hot, creditDevRev1, creditDev, firstAddDev, hG, hp]
        norm_num [Prices.sm120, Params.pi, sh8192])
    (by have h0 := h.cost_nonneg Prices.sm120 sh8192 (by norm_num [Prices.sm120])
        rw [wrefDevRev1Hot, creditDevRev1Hot, creditDevRev1, creditDev, firstAddDev, hotFoldDev, hG, hp]
        generalize h.cost Prices.sm120 sh8192 = x at h0 ⊢
        norm_num [Prices.sm120, Params.pi, sh8192]
        linarith)
    hacc hTT

