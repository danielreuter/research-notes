/-- **v2-hot at the cap 1/1,000, 8192³**, FP32 at 8.00, the honest cast at 8, under any H_i sizing rule `h`: γ =
`gammaHot d h (8 - 8) (1 / 1000) sh8192` (`gammaHot_…` give its values). -/
theorem pearlCGammaSm120v2HotCast8_8192
    (P : Protocol Q R S) (D : Layout → Prop) (d : PearlCDevice) (h : HotSizing) (hG : d.G = 0)
    (hp : d.prices = Prices.sm120)
    (hacc : HotUnitAccounting P D d h (8 - 8) (1 / 1000) sh8192)
    (hTT : TTOut CM P D (1 / 400) εPearlC) :
    Gγ CM P D (gammaHot d h (8 - 8) (1 / 1000) sh8192 : ℝ) εPearlC :=
  pearlCGammaHotAt CM P D d h _ _ _ (by norm_num)
    (by rw [creditDevHot, creditDev, hG, hp]
        norm_num [Prices.sm120, Params.pi, sh8192])
    (by have h0 := h.cost_nonneg Prices.sm120 sh8192 (by norm_num [Prices.sm120])
        rw [wrefDevHot, creditDevHot, creditDev, hG, hp]
        generalize h.cost Prices.sm120 sh8192 = x at h0 ⊢
        norm_num [Prices.sm120, Params.pi, sh8192]
        linarith)
    hacc hTT

