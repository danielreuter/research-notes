From 5f22dcdef001b9b5098b0f060a081dce0388e03f Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 25 Sep 2026 18:02:22 +0000
Subject: [PATCH 1/3] bench: classify vllm-v1 position-leaf results as
 'B-Ligero + vllm-v1 SHA-256 in circuit' on the vllm-v1 line (drilldown
 variant, views configuration)

Co-authored-by: danielreuter <danielreuter@users.noreply.github.com>
---
 .../numerical/python/verity_numerical/bench/drilldown.py  | 8 ++++++++
 backends/numerical/python/verity_numerical/bench/views.py | 5 +++++
 backends/numerical/tests/bench/test_drilldown.py          | 3 ++-
 backends/numerical/tests/bench/test_views.py              | 6 +++---
 4 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/backends/numerical/python/verity_numerical/bench/drilldown.py b/backends/numerical/python/verity_numerical/bench/drilldown.py
index 46c5abfb..f41c40f1 100644
--- a/backends/numerical/python/verity_numerical/bench/drilldown.py
+++ b/backends/numerical/python/verity_numerical/bench/drilldown.py
@@ -134,6 +134,8 @@ def features(env: Mapping[str, Any], meta: Mapping[str, Any] | None = None) -> d
         f["leaf"] = f"ajtai-n{n.group(1)}" if n else "ajtai"
     elif "blake3" in named:
         f["leaf"] = "blake3"
+    elif "vllm-v1" in named:
+        f["leaf"] = "vllm-v1"
     elif "sha256" in named:
         f["leaf"] = "sha256"
     elif "poseidon2" in named or "poseidon2" in name:
@@ -268,6 +270,12 @@ VARIANTS: tuple[Variant, ...] = (
             "SHA-256 collision resistance: frame-v3 sha256/row/v1 row leaves, the data-block compressions in-circuit, the chaining "
             "value published and the padding block compressed by the verifier; a tagged SHA-256 domain for malformed frames",
             _H_SOUND, "No: " + _KEEP_FROZEN, "b-ligero-sha256 (red-team-standard-hash pending)"),
+    Variant("B-Ligero + vllm-v1 SHA-256 in circuit", "B-Ligero", "B-Ligero, authentication included-hash*, leaf vllm-v1 (vllm-v1/pos-leaf/v0)",
+            lambda f: _hashed(f, "vllm-v1"),
+            _H_ZK, "x, W committed; digests deterministic, not hiding (as the frame-v3 SHA-256 leaf)",
+            "SHA-256 collision resistance: vllm-v1 position leaves with every compression in-circuit (the padding block "
+            "included), vllm-v1 node/lift trees bound by step roots over verifier-derived domains (PROTOCOL.md section 9); "
+            "a tagged SHA-256 domain for malformed digests", _H_SOUND, "No: " + _KEEP_FROZEN, "b-ligero-vllm-v1 (red-team pending)"),
     Variant("B-Ligero + Ajtai n=64", "B-Ligero", "B-Ligero, authentication included-hash*, hash / leaf ajtai…n64",
             lambda f: _hashed(f, "ajtai-n64"),
             _H_ZK, "No hiding: binding-only, a low-entropy row can be brute-forced from its public digest (red-team-leaf-3)",
diff --git a/backends/numerical/python/verity_numerical/bench/views.py b/backends/numerical/python/verity_numerical/bench/views.py
index 94f527de..58256e8b 100644
--- a/backends/numerical/python/verity_numerical/bench/views.py
+++ b/backends/numerical/python/verity_numerical/bench/views.py
@@ -254,6 +254,11 @@ CONFIGURATIONS: tuple[Configuration, ...] = (
          "frame-v3 SHA-256 trees over sha256/row/v1 row digests (prefix block and padding block by the verifier)" + _IN_PROOF,
          (_SHA256_STMT, Hash("SHA-256", _STMT, _CR + " (row digests)"), *_B_HASHES), assumptions=_B_ASSUME,
          pin=_B_PIN + "; leaf schema sha256/row/v1", **_B_KW),
+    _cfg("B-Ligero + vllm-v1 SHA-256 in circuit", FULL, _H_PORTS, "vllm-v1",
+         "vllm-v1 SHA-256 trees over position leaves of every operand row (all compressions in-circuit), bound by step roots "
+         "over verifier-derived domains whose digests the statement absorbs" + _IN_PROOF,
+         (_SHA256_STMT, Hash("SHA-256", _STMT, _CR + " (position leaves)"), *_B_HASHES), assumptions=_B_ASSUME,
+         pin=_B_PIN + "; leaf schema vllm-v1/pos-leaf/v0, step-root domains", **_B_KW),
     _cfg("B-Ligero + Ajtai n=64", FULL, _H_PORTS + " (binding only, not hiding)", "frame-v3/ajtai-row",
          "SHA-256 trees over Ajtai (Ring-SIS, n = 64) row digests" + _IN_PROOF,
          (_SHA256_STMT, Hash("Ajtai n=64 (linear digest)", _STMT, "Ring-SIS binding", True), *_B_HASHES),
diff --git a/backends/numerical/tests/bench/test_drilldown.py b/backends/numerical/tests/bench/test_drilldown.py
index 3d0a0180..5169f2ce 100644
--- a/backends/numerical/tests/bench/test_drilldown.py
+++ b/backends/numerical/tests/bench/test_drilldown.py
@@ -23,7 +23,7 @@ from test_tables import RTX4090, VERIFIER, cell, hashed, put, put_registered, re
 SEEDS = ("B-Ligero v1", "B-Ligero v3 (private selection)", "B-Ligero v3 fused hints", "B-Ligero v3x4 fused (l=4096)", "B-Ligero v1x4 (fold)",
          "B-Ligero v3x4 (fold)", "B-Ligero v2 (public selection)", "B-Ligero v2x4 (public selection)", "B-Ligero Fiat–Shamir (HVZK)",
          "B-Ligero + Poseidon2 per row", "B-Ligero + Poseidon2 shared 64x64 tile", "B-Ligero + BLAKE3 in circuit",
-         "B-Ligero + SHA-256 in circuit", "B-Ligero + Ajtai n=64", "B-Ligero + Ajtai n=128", "B-Ligero native external authentication",
+         "B-Ligero + SHA-256 in circuit", "B-Ligero + vllm-v1 SHA-256 in circuit", "B-Ligero + Ajtai n=64", "B-Ligero + Ajtai n=128", "B-Ligero native external authentication",
          "Ligerito", "A-GKR CPU (Rust)", "A-GKR GPU (torch/Triton)",
          "SP1 stock (relation-only / bare guest)", "SP1 stock, FRI query count raised (otherwise unmodified)",
          "SP1 stock, committed (frame-v3 SHA-256 rows)", "SP1 stock, committed (vllm-v1 SHA-256 position leaves)", "SP1 precompile (TC_DOT chip)")
@@ -66,6 +66,7 @@ CASES = [
     (env(FP8, auth="included-hash", sharing="tile64x64", **P2), {}, "B-Ligero + Poseidon2 shared 64x64 tile"),
     (env(FP8, auth="included-hash", sharing="none", **leaf("blake3", "blake3-keyed", "blake3-keyed/row/v2")), {}, "B-Ligero + BLAKE3 in circuit"),
     (env(FP8, auth="included-hash", sharing="none", **leaf("sha256", "sha256", "sha256/row/v1")), {}, "B-Ligero + SHA-256 in circuit"),
+    (env(FP8, auth="included-hash", sharing="none", **leaf("vllm-v1", "sha256", "vllm-v1/pos-leaf/v0")), {}, "B-Ligero + vllm-v1 SHA-256 in circuit"),
     (env(FP8, auth="included-hash", sharing="none", **leaf("ajtai-n64", "ajtai-babybear-n64-b1-r0/v1", "ajtai-babybear-n64-b1-r0/row/v1")), {},
      "B-Ligero + Ajtai n=64"),
     (env(FP8, auth="included-hash", sharing="none", **leaf("ajtai-n128", "ajtai-babybear-n128-b1-r0/v1", "ajtai-babybear-n128-b1-r0/row/v1")), {},
diff --git a/backends/numerical/tests/bench/test_views.py b/backends/numerical/tests/bench/test_views.py
index 9c715c6c..12fc4b71 100644
--- a/backends/numerical/tests/bench/test_views.py
+++ b/backends/numerical/tests/bench/test_views.py
@@ -370,11 +370,11 @@ def test_table1_carries_the_security_properties(store: LocalStore) -> None:
     assert {c.id for c in V.CONFIGURATIONS} == {v.id for v in V.D.VARIANTS}
     full = {c.id for c in V.CONFIGURATIONS if c.full_relation}
     assert full == {"B-Ligero + Poseidon2 per row", "B-Ligero + Poseidon2 shared 64x64 tile", "B-Ligero + BLAKE3 in circuit",
-                    "B-Ligero + SHA-256 in circuit", "B-Ligero + Ajtai n=64", "B-Ligero + Ajtai n=128",
-                    "SP1 stock, committed (frame-v3 SHA-256 rows)", "SP1 stock, committed (vllm-v1 SHA-256 position leaves)"}
+                    "B-Ligero + SHA-256 in circuit", "B-Ligero + vllm-v1 SHA-256 in circuit", "B-Ligero + Ajtai n=64",
+                    "B-Ligero + Ajtai n=128", "SP1 stock, committed (frame-v3 SHA-256 rows)", "SP1 stock, committed (vllm-v1 SHA-256 position leaves)"}
     assert [c.id for c in V.CONFIGURATIONS if c.full_relation and not c.scheme_problem()] == [
         "B-Ligero + Poseidon2 per row", "B-Ligero + BLAKE3 in circuit", "B-Ligero + SHA-256 in circuit",
-        "SP1 stock, committed (frame-v3 SHA-256 rows)", "SP1 stock, committed (vllm-v1 SHA-256 position leaves)"]
+        "B-Ligero + vllm-v1 SHA-256 in circuit", "SP1 stock, committed (frame-v3 SHA-256 rows)", "SP1 stock, committed (vllm-v1 SHA-256 position leaves)"]
     assert all(x.basis.startswith(("proven", "conjectured")) for c in V.CONFIGURATIONS for x in c.proximity)
     assert all(c.proximity and c.hashes and c.dominant_term for c in V.CONFIGURATIONS)
     committed(store, t_total=0.4)
