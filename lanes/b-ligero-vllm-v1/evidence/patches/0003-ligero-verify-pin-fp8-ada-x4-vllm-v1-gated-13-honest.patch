From f84192916513cdb4e49d5d074a6dac1cfe22549c Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 25 Sep 2026 18:10:38 +0000
Subject: [PATCH 3/3] ligero-verify: pin fp8-ada-x4+vllm-v1 (gated 13 honest +
 86 negatives, 0 failures); conformance passes the vllm-v1 shape

Co-authored-by: danielreuter <danielreuter@users.noreply.github.com>
---
 backends/direct/ligero/leaf/conformance_test.py | 5 +++--
 backends/ligero-verify/src/leaf.rs              | 5 +++++
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/backends/direct/ligero/leaf/conformance_test.py b/backends/direct/ligero/leaf/conformance_test.py
index c5fed01b..58b0ba0c 100644
--- a/backends/direct/ligero/leaf/conformance_test.py
+++ b/backends/direct/ligero/leaf/conformance_test.py
@@ -191,11 +191,12 @@ def test_compose_prove_verify_publishes_the_native_digests(name: str, runners) -
     # the committed trees open at those digests under the scheme's framing
     auth = pubs[3]
     ok, why = hashauth.verify_hash_auth(auth, pubs[4], digests=published, y_words=np.asarray(pubs[2])[ends],
-                                        y_bits=R.rel.y_bits, leaf=s)
+                                        y_bits=R.rel.y_bits, leaf=s, vshape=R.vshape)
     assert ok, why
     bad = published.copy()
     bad[1, s.digest_elems] ^= 1
-    ok, why = hashauth.verify_hash_auth(auth, pubs[4], digests=bad, y_words=np.asarray(pubs[2])[ends], y_bits=R.rel.y_bits, leaf=s)
+    ok, why = hashauth.verify_hash_auth(auth, pubs[4], digests=bad, y_words=np.asarray(pubs[2])[ends], y_bits=R.rel.y_bits, leaf=s,
+                                        vshape=R.vshape)
     assert not ok and why.startswith("auth: b:")
 
 
diff --git a/backends/ligero-verify/src/leaf.rs b/backends/ligero-verify/src/leaf.rs
index c5af57c4..56df787d 100644
--- a/backends/ligero-verify/src/leaf.rs
+++ b/backends/ligero-verify/src/leaf.rs
@@ -619,6 +619,11 @@ pub static PINS: &[(&str, &str, &str, &str)] = &[
     // gated 2048 VUs (13 honest sub-batches) + 86 negatives at 98d878ca, r20260925-104053-b438, 2026-09-25 10:43Z
     ("bf16-hopper-x4", "sha256", "a02f283de13acd94d47be4e8c794a6c89b833cc2d9151b92393dd6ac37defe62",
      "1b879d1a3ec16e23f886f792900a089fcbc4b080dbddffe4d45a07d64551525a"),
+    // lane b-ligero-vllm-v1, schema `vllm-v1/pos-leaf/v0`: `hashchain.compose(<rel>, "vllm-v1")` (every position-leaf
+    // compression in-circuit, 3 per operand per x4 column; 127,536 rows per column), gated 2048 VUs (13 honest sub-batches)
+    // + 86 negatives, 0 failures, on vy-b-ligero-vllm-v1-4090 r20260925-180400-c457 2026-09-25 18:12Z
+    ("fp8-ada-x4", "vllm-v1", "f7f316139a176eaed1c52a09869d748fc9fd54ef99e9425a9feae041919446d4",
+     "8330132438e6c6adbb25a1371afb3d0dcf580af3d7a5ce53ecd141c983830479"),
 ];
 
 pub fn names() -> Vec<&'static str> {
