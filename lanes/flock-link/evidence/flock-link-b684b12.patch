+/// A link claim (verity flock-link): `ẑ(point) = value` for the bit-MLE of the
+/// PADDED union witness at a fully multilinear point of `M` coordinates,
+/// LSB-first over the bit address. Opened as a ring-switched claim whose 64
+/// skip weights are the eq tensor of `point[0..6]` ([`eq_skip_weights`]), not
+/// a φ₈ Lagrange functional.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LinkClaim {
+    pub point: Vec<F128>,
+    pub value: F128,
+}
+
+/// `eq(r, j)` for the `2^r.len()` Boolean `j` (bit `k` of `j` against `r[k]`).
+pub fn eq_skip_weights(r: &[F128]) -> Vec<F128> {
+    let mut w = vec![F128::ONE];
+    for &rk in r {
+        let mut next = Vec::with_capacity(2 * w.len());
+        next.extend(w.iter().map(|x| *x * (F128::ONE + rk)));
+        next.extend(w.iter().map(|x| *x * rk));
+        w = next;
+    }
+    w
+}
