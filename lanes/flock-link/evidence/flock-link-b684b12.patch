+#[allow(clippy::too_many_arguments)]
+pub fn verify_ligerito_union_circuit_linked<Ch: Challenger>(
+    union: &UnionInstance<'_>,
+    circuit: &Circuit,
+    public: &[F128],
+    circuits: &[&dyn LincheckCircuit],
+    commitment: &Commitment,
