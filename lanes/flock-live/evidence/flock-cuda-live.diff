+    }
+}
+fn g128_other(l: flock_core::pcs::ligerito::LigeritoProfile) -> flock_core::pcs::ligerito::LigeritoProfile {
+    use flock_core::pcs::ligerito::LigeritoProfile as L;
+    if l == L::Fast { L::Fast100 } else { L::Fast }
+}
+fn g128_reps() -> usize {
