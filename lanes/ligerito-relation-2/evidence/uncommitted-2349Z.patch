+def _expect(lay, cons, z_bad, pubs, cheat, where):
+    proof = sc.prove(lay, cons, z_bad, sc.LocalCoins(b"n"), cheat=cheat)
+    ok, why, _ = sc.verify(lay, cons, pubs, proof, sc.LocalCoins(b"n"))
+    assert not ok and where in why, (cheat, why)
