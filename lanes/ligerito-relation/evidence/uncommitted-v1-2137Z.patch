+def zero_blocks(lay: Layout, zk: bool) -> list[tuple[int, int]]:
+    """The aligned row blocks ``(prefix, b)`` = rows ``[prefix << b, (prefix + 1) << b)`` covering the rows the commitment
+    must be zero on: the virtual rows ``[m, m + n_virt)`` (ZK: the mask rows sit above them), or all of ``[m, R)``.
+    Without these claims the prover commits non-zero virtual rows and the verifier's reconstruction
+    ``w~ + sum eq . pub~`` absorbs any change of the public rows (red-team-ligerito-2 V1)."""
+    lo, hi = lay.m, (lay.m + len(lay.virt)) if zk else lay.R
+    out, i = [], lo
+    while i < hi:
+        b = 0
+        while i % (2 << b) == 0 and i + (2 << b) <= hi:
+            b += 1
+        out.append((i >> b, b))
+        i += 1 << b
+    return out
+
+
+def zero_points(lay: Layout, point: np.ndarray, blocks: list[tuple[int, int]]) -> list[np.ndarray]:
+    """Per block, ``(rho_i[:b] || bits(prefix) || rho_c)`` in the sumcheck's order: the block's restriction of ``w`` at the
+    combined sumcheck's point (drawn after the root, so independent of ``w``); ``w~`` there is 0 iff (w.h.p.) the block is."""
+    out = []
+    for pfx, b in blocks:
+        p = np.array(point, dtype=np.int64, copy=True)
+        p[b:lay.n_i] = 0
+        p[b:lay.n_i, 0] = [(pfx >> (j - b)) & 1 for j in range(b, lay.n_i)]
+        out.append(p)
+    return out
+
+
