+def mm_mod(A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:
+    """``(A @ B) % P`` (batched, broadcasting like ``torch.matmul``) for residues ``A`` (..., m, k), ``B`` (..., k, n)
+    with ``k < 2^21``: four float64 GEMMs on 16-bit limbs -- every partial sum an integer < k 2^32 < 2^53, so exact
+    whatever the summation order (the device has no int64 GEMM; the elementwise form materialises all m k n products)."""
+    a0, a1 = (A & 0xFFFF).to(torch.float64), (A >> 16).to(torch.float64)
+    b0, b1 = (B & 0xFFFF).to(torch.float64), (B >> 16).to(torch.float64)
+    s00 = torch.matmul(a0, b0).to(torch.int64)
+    mid = (torch.matmul(a0, b1).to(torch.int64) + torch.matmul(a1, b0).to(torch.int64)) % P
+    s11 = torch.matmul(a1, b1).to(torch.int64) % P
+    return (s11 * (2**32 % P) + mid * 2**16 + s00) % P
+
+
