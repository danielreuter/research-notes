diff --git a/backends/direct/ligero/chain_test.py b/backends/direct/ligero/chain_test.py
index 80720c3e..d39e4998 100644
--- a/backends/direct/ligero/chain_test.py
+++ b/backends/direct/ligero/chain_test.py
@@ -83,3 +83,25 @@ def test_component_ends_fp4():
     assert sys.chain.get("y16") is None and len(sys.chain["y_end"]) == 3
     _check(sys, STEPS, 2, 64, 32)
     _check(sys, STEPS, 5, 128, 32, seed=4)
+
+
+def test_mm_mod_and_fp_values_are_the_elementwise_sums() -> None:
+    """The limb-GEMM contraction equals the per-term reduced elementwise sum, at the extremes (P - 1) and at random, and
+    the fingerprints through it equal their definition."""
+    from .chain import FP_LANES, fp_values, mm_mod, rho_powers
+    g = torch.Generator().manual_seed(3)
+    for m, k, n in ((5, 8, 768), (7, 768, 10), (1, 1, 1)):
+        A = torch.randint(0, P, (2, m, k), generator=g, dtype=torch.int64)
+        B = torch.randint(0, P, (k, n), generator=g, dtype=torch.int64)
+        A[0, 0] = P - 1
+        B[:, 0] = P - 1
+        ref = ((A[:, :, :, None] * B[None, None, :, :]) % P).sum(2) % P
+        assert torch.equal(mm_mod(A, B), ref)
+    n_op, steps, C, n_slots = 2, 3, 4, 5
+    lanes = torch.randint(0, P, (n_op * FP_LANES, n_slots * steps + 2), generator=g, dtype=torch.int64)
+    rho = torch.randint(0, P, (C,), generator=g, dtype=torch.int64)
+    pw = rho_powers(rho, steps)
+    F = fp_values(lanes, rho, n_op, steps, n_slots * steps + 2)
+    for v, o, x in ((0, 0, 0), (4, 1, 3), (2, 1, 1)):
+        want = sum(int(pw[x, s, i]) * int(lanes[o * FP_LANES + i, steps * v + s]) for s in range(steps) for i in range(FP_LANES)) % P
+        assert int(F[v, o, x]) == want
