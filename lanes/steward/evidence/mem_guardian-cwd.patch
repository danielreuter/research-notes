+def proc_cwd(pid: int) -> str:
+    """The process's working directory, read before the kill ('?' when lsof cannot say within a second)."""
+    try:
+        out = subprocess.run(["/usr/sbin/lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
+                             capture_output=True, text=True, timeout=1).stdout
+    except (OSError, subprocess.SubprocessError):
+        return "?"
+    return next((line[1:] for line in out.splitlines() if line.startswith("n")), "?")
+
+
 def kill(pid: int, mem: float, cmd: str, reason: str) -> None:
